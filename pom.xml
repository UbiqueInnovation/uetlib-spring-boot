<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.ubique</groupId>
        <artifactId>uetlib-parent</artifactId>
        <version>2026.06.0</version>
    </parent>

    <artifactId>uetlib-spring-boot-parent</artifactId>
    <version>3.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <uetlib-test.version>2.0.1</uetlib-test.version>
        <uetlib-core.version>2.3.3</uetlib-core.version>
        <uetlib-geo.version>3.1.1</uetlib-geo.version>

        <!-- westemeyer version config -->
        <westemeyer-version-package-name>ch.ubique.backend.spring.boot.version</westemeyer-version-package-name>

        <sonar.projectName>uetlib-spring-boot</sonar.projectName>
        <sonar.coverage.module>uetlib-spring-boot-coverage</sonar.coverage.module>
    </properties>

    <modules>
        <module>uetlib-spring-boot</module>
        <module>uetlib-spring-boot-geo</module>
        <module>uetlib-spring-boot-security</module>
        <module>uetlib-spring-boot-coverage</module>
    </modules>

    <dependencies>
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-test</artifactId>
            <version>${uetlib-test.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>ubique-artifactory</id>
            <name>backend</name>
            <url>https://artifactory.ubique.ch/artifactory/backend</url>
        </repository>
        <repository>
            <id>ubique-artifactory-virtual</id>
            <name>ubique</name>
            <url>https://artifactory.ubique.ch/artifactory/ubique</url>
        </repository>
        <repository>
            <id>osgeo</id>
            <name>Open Source Geospatial Foundation Repository</name>
            <url>https://repo.osgeo.org/repository/release/</url>
        </repository>
    </repositories>

    <scm child.scm.url.inherit.append.path="false">
        <url>https://github.com/UbiqueInnovation/uetlib-spring-boot</url>
    </scm>
</project>
